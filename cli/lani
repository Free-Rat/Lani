#!/usr/bin/env bash
# lani — service catalog and test-run manager for a Lani host
#
# Reads the catalog from $LANI_CATALOG and drives the services repository at
# $LANI_SERVICES. Both are set for you inside the workbench container.
#
# Usage:
#   lani modules list
#   lani modules use <name>
#   lani modules status
#
# SC2059 is excluded in cli/default.nix, not here: writeShellApplication prepends its own
# header, so a file-level directive would come after a command and be ignored.
set -euo pipefail

# ── colors ──────────────────────────────────────────────────────────────────────
# Respects NO_COLOR (https://no-color.org/) and non-terminal stdout.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  R=$'\e[0m'    B=$'\e[1m'    DIM=$'\e[2m'
  CYN=$'\e[36m'
  BCYN=$'\e[96m' BYLW=$'\e[93m' BRED=$'\e[91m' BGRN=$'\e[92m' BWHT=$'\e[97m'
else
  R='' B='' DIM='' CYN='' BCYN='' BYLW='' BRED='' BGRN='' BWHT=''
fi

_SEP="$(printf '%0.s─' $(seq 1 72))"
sep()  { printf "${DIM}%s${R}\n"                      "$_SEP"; }
hdr()  { printf "\n  ${B}${BCYN}%s${R}  ${DIM}%s${R}\n" "$1" "${2:-}"; }
info() { printf "\n  ${BCYN}▸${R}  %s\n"              "$*"; }
ok()   { printf "  ${BGRN}✓${R}  %s\n"                "$*"; }
die()  { printf "\n  ${BRED}✗${R}  %s\n\n" "$*" >&2; exit 1; }

# ── CI status helpers ────────────────────────────────────────────────────────────

# _hl_write_status name started phase result detail log_base status_file
# phase: post_scaffold | build | test | pass | fail
_hl_write_status() {
  local name="$1" started="$2" phase="$3" result="${4:-}" detail="${5:-}" \
        log_base="$6" status_file="$7"
  local s0 s1 s2 s3
  case "$phase" in
    post_scaffold) s0="done";  s1="pending"; s2="pending"; s3="pending" ;;
    build)         s0="done";  s1="running"; s2="pending"; s3="pending" ;;
    test)          s0="done";  s1="done";    s2="running"; s3="pending" ;;
    pass)          s0="done";  s1="done";    s2="done";    s3="done"    ;;
    fail)          s0="done";  s1="done";    s2="fail";    s3="fail"    ;;
    *)             s0="done";  s1="pending"; s2="pending"; s3="pending" ;;
  esac
  local rj dj
  [ -n "$result" ] && rj="\"$result\"" || rj=null
  [ -n "$detail" ] && dj="\"${detail//\"/\\\"}\"" || dj=null
  cat > "$status_file" <<_STATUS_EOF
{
  "name": "$name",
  "started": "$started",
  "phases": [
    { "key": "scaffold", "label": "Scaffolding", "status": "$s0" },
    { "key": "build",    "label": "Building",    "status": "$s1" },
    { "key": "test",     "label": "Testing",     "status": "$s2" },
    { "key": "done",     "label": "Done",        "status": "$s3" }
  ],
  "log": "$log_base",
  "result": $rj,
  "detail": $dj
}
_STATUS_EOF
}

_hl_gen_dashboard() {
  local ci_dir="$1"
  cat > "${ci_dir}/index.html" << 'DASH_EOF'
<!DOCTYPE html><html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Lani CI</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{background:#0d1117;color:#e6edf3;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5}
header{background:#161b22;border-bottom:1px solid #30363d;padding:12px 24px;display:flex;align-items:center;gap:10px}
.hdr-logo{font-size:15px;font-weight:700;color:#58a6ff}
.hdr-sep{color:#30363d}
.hdr-mod{font-size:14px;color:#c9d1d9;font-weight:600}
.hdr-ts{font-size:11px;color:#6e7681;margin-left:auto}
.phases{display:flex;align-items:stretch;padding:16px 24px;gap:0;flex-wrap:wrap}
.ph-conn{width:24px;display:flex;align-items:center;justify-content:center;color:#30363d;font-size:14px;flex-shrink:0}
.ph{background:#161b22;border:1px solid #30363d;border-radius:6px;padding:10px 16px;min-width:120px}
.ph-label{font-size:10px;text-transform:uppercase;letter-spacing:.6px;color:#6e7681;margin-bottom:5px}
.ph-st{font-size:13px;font-weight:600;display:flex;align-items:center;gap:5px}
.ph-st.done{color:#3fb950}.ph-st.running{color:#58a6ff}.ph-st.pending{color:#484f58}.ph-st.fail{color:#f85149}
.spin{width:11px;height:11px;flex-shrink:0;border:2px solid currentColor;border-top-color:transparent;border-radius:50%;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
#result{margin:0 24px 12px;padding:10px 16px;border-radius:6px;font-weight:600;font-size:13px;display:none}
#result.pass{background:#0a2516;border:1px solid #3fb950;color:#3fb950}
#result.fail{background:#2d0e0e;border:1px solid #f85149;color:#f85149}
.log-wrap{margin:0 24px 24px}
.log-hdr{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:#6e7681;margin-bottom:6px}
#log{background:#161b22;border:1px solid #30363d;border-radius:6px;padding:12px 14px;font-family:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace;font-size:12px;line-height:1.65;overflow-y:auto;max-height:55vh;white-space:pre-wrap;word-break:break-all;color:#c9d1d9}
.blink{animation:blink 1s step-end infinite}@keyframes blink{50%{opacity:0}}
</style></head><body>
<header>
  <span class="hdr-logo">Lani CI</span>
  <span class="hdr-sep">/</span>
  <span class="hdr-mod" id="hdr-mod">—</span>
  <span class="hdr-ts" id="hdr-ts"></span>
</header>
<div class="phases" id="phases"><div style="color:#484f58;padding:4px 0">Loading…</div></div>
<div id="result"></div>
<div class="log-wrap">
  <div class="log-hdr">Agent output</div>
  <div id="log">Waiting for agent to start<span class="blink">▌</span></div>
</div>
<script>
const q=new URLSearchParams(location.search),mod=q.get('m')||'';
let logFile=null;
function phIcon(s){
  if(s==='done')    return '<span>✓</span>';
  if(s==='running') return '<span class="spin"></span>';
  if(s==='fail')    return '<span>✗</span>';
  return '<span style="opacity:.35">·</span>';
}
function renderPhases(ph){
  document.getElementById('phases').innerHTML=ph.map((p,i)=>
    (i>0?'<div class="ph-conn">›</div>':'')+
    `<div class="ph"><div class="ph-label">${p.label}</div>`+
    `<div class="ph-st ${p.status}">${phIcon(p.status)} ${p.status}</div></div>`
  ).join('');
}
async function tick(){
  try{
    const r=await fetch(`status/${mod}.json?_=${Date.now()}`);
    if(r.ok){
      const s=await r.json();
      document.getElementById('hdr-mod').textContent=s.name||mod;
      if(s.started)document.getElementById('hdr-ts').textContent='started '+s.started;
      if(s.phases)renderPhases(s.phases);
      if(s.result){
        const b=document.getElementById('result');
        b.className=s.result;
        b.textContent=s.result==='pass'
          ?'✓  '+(s.name||mod)+' passed all health checks'
          :'✗  Failed — '+(s.detail||'see log below');
        b.style.display='';
      }
      if(s.log&&s.log!==logFile)logFile=s.log;
    }
  }catch(_){}
  if(logFile){
    try{
      const r2=await fetch(`logs/${logFile}?_=${Date.now()}`);
      if(r2.ok){
        const txt=await r2.text();
        const box=document.getElementById('log');
        const atBottom=box.scrollHeight-box.scrollTop-box.clientHeight<80;
        box.textContent=txt||'(no output yet)';
        if(atBottom)box.scrollTop=box.scrollHeight;
      }
    }catch(_){}
  }
  setTimeout(tick,2000);
}
